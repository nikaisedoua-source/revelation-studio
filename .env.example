# Optional overrides. Configure keys in the Studio > IA & quotas screen.
# The Studio reads its process environment; source this file in your launcher
# only after replacing the examples. Never commit your actual credentials.
# REVELATION_DATA_DIR=/path/to/private/studio-data
# REVELATION_MODELS_DIR=/path/to/models
# REVELATION_OUTPUT_DIR=/path/to/productions
# REVELATION_FFMPEG=/path/to/ffmpeg
# REVELATION_APP_AFTER_EFFECTS=/Applications/Adobe After Effects/Adobe After Effects.app
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# COHERE_API_KEY=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
